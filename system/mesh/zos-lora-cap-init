#!/bin/sh
# Prepare the M5Stack Cap LoRa-1262 before a radio daemon starts.
# Runs as ExecStartPre (as root) for meshtasticd and openhop-repeater.
#
#  1. The cap's RF antenna switch (FM8625H) is driven by P0 of a
#     PI4IOE5V6408 I/O expander at 0x43 on I2C1. It must be an output, driven
#     high, before the SX1262 can transmit or receive. This is the same
#     sequence Meshtastic uses for the cap on the Cardputer-Adv.
#  2. The CardputerZero switches 5 V to its HAT/cap header with BCM GPIO5
#     (named G5_HAT_5VOUT_EN in M5Stack's device tree; the same line
#     M5Stack's own launcher drives for its LoRa app). Set ZOS_HAT_POWER_GPIO
#     to another number, or to "none" to leave it alone.
#
# Never fails the daemon start: a missing cap shows up as a radio error in
# the daemon's own log, which is more useful than a refused start.

BUS=${ZOS_LORA_I2C_BUS:-1}
ADDR=${ZOS_LORA_EXPANDER:-0x43}
log() { echo "zos-lora-cap-init: $*"; }

# --- header power ------------------------------------------------------------
HAT_GPIO=${ZOS_HAT_POWER_GPIO:-5}
if [ "$HAT_GPIO" != none ]; then
    if command -v pinctrl >/dev/null 2>&1; then          # Raspberry Pi OS (raspi-utils)
        # pinctrl leaves the pin driven after it exits, unlike gpioset
        pinctrl set "$HAT_GPIO" op dh && log "header 5V on (GPIO$HAT_GPIO)"
    elif command -v gpioset >/dev/null 2>&1; then
        if gpioset --help 2>&1 | grep -q -- '--mode'; then    # libgpiod 1.x
            gpioset --mode=exit gpiochip0 "$HAT_GPIO=1" && log "header 5V on (GPIO$HAT_GPIO)"
        else                                                  # libgpiod 2.x
            gpioset -t0 -c gpiochip0 "$HAT_GPIO=1" && log "header 5V on (GPIO$HAT_GPIO)"
        fi
    else
        log "no pinctrl/gpioset: header power not switched"
    fi
    sleep 0.05
fi

# --- antenna switch -----------------------------------------------------------
if ! command -v i2cset >/dev/null 2>&1; then
    log "i2c-tools missing (apt install i2c-tools); antenna switch not enabled"
    exit 0
fi
if [ ! -e "/dev/i2c-$BUS" ]; then
    log "/dev/i2c-$BUS missing: enable I2C (dtparam=i2c_arm=on)"
    exit 0
fi
ok=1
i2cset -y "$BUS" "$ADDR" 0x03 0x01 || ok=0   # IO direction: P0 output
i2cset -y "$BUS" "$ADDR" 0x07 0x00 || ok=0   # output high-impedance: off
i2cset -y "$BUS" "$ADDR" 0x05 0x01 || ok=0   # output state: P0 high
if [ $ok = 1 ]; then
    log "antenna switch enabled (expander $ADDR on i2c-$BUS)"
else
    log "no answer from $ADDR on i2c-$BUS: is the cap fitted and the header powered?"
fi
exit 0
