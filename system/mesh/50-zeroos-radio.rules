// ZeroOS: let the shell's user start and stop the two LoRa daemons (and
// nothing else) without a password, so the mesh apps can switch the radio.
// Installed to /etc/polkit-1/rules.d/ by tools/install-mesh.sh, which
// replaces @ZOS_USER@ with the user ZeroOS runs as.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        subject.user == "@ZOS_USER@") {
        var unit = action.lookup("unit");
        var verb = action.lookup("verb");
        if ((unit == "meshtasticd.service" || unit == "openhop-repeater.service") &&
            (verb == "start" || verb == "stop" || verb == "restart")) {
            return polkit.Result.YES;
        }
    }
});
