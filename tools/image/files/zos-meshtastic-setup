#!/bin/bash
# Set Meshtastic region and owner once; values come from /etc/zeroos.conf.
set -u
. /etc/zeroos.conf        # ZOS_MESH_NAME, ZOS_MESHTASTIC_REGION
CLI=/opt/zeroos/meshtastic-cli/bin/meshtastic
[ -x "$CLI" ] || { echo "zos-meshtastic-setup: $CLI missing"; exit 0; }
for _ in $(seq 1 30); do
    (exec 3<>/dev/tcp/127.0.0.1/4403) 2>/dev/null && break
    sleep 1
done
name=${ZOS_MESH_NAME:-$(hostname)}
short=$(echo "$name" | tr -cd 'A-Za-z0-9' | cut -c1-4 | tr a-z A-Z)
if "$CLI" --host 127.0.0.1 --set lora.region "${ZOS_MESHTASTIC_REGION:-EU_868}" \
        --set-owner "$name" --set-owner-short "${short:-ZERO}"; then
    mkdir -p /var/lib/zeroos && touch /var/lib/zeroos/meshtastic-configured
    echo "zos-meshtastic-setup: region ${ZOS_MESHTASTIC_REGION:-EU_868}, owner $name"
else
    echo "zos-meshtastic-setup: meshtasticd did not answer (no cap fitted?); will retry next start"
fi
exit 0
